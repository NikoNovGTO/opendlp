+function Show-DemoGuide($Owner) {
+    $guide=[Windows.Forms.Form]::new()
+    try {
+        $guide.Text='OurDLP — Инструкция и помощь';$guide.Size=[Drawing.Size]::new(820,700);$guide.MinimumSize=[Drawing.Size]::new(600,450)
+        $guide.StartPosition='CenterParent';$guide.Font=[Drawing.Font]::new('Segoe UI',11);$guide.AutoScaleMode='Dpi'
+        $tabs=[Windows.Forms.TabControl]::new();$tabs.Dock='Fill';$guide.Controls.Add($tabs)
+        foreach($topic in Get-DemoGuideTopics){
+            $tab=[Windows.Forms.TabPage]::new();$tab.Text=$topic.Title;$tab.Padding=[Windows.Forms.Padding]::new(12)
+            $text=[Windows.Forms.RichTextBox]::new();$text.Dock='Fill';$text.ReadOnly=$true;$text.BorderStyle='None'
+            $text.BackColor=[Drawing.Color]::White;$text.Font=$guide.Font;$text.DetectUrls=$false;$text.Text=$topic.Text
+            $tab.Controls.Add($text);$tabs.TabPages.Add($tab)
+        }
+        $guide.ShowDialog($Owner)|Out-Null
+    } finally {$guide.Dispose()}
+}
